{
  "name": "silver-life-knowledge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "publish:notes": "node scripts/publish/index.mjs",
    "publish:site": "node scripts/publish/site.mjs",
    "validate:content": "node scripts/validate/content.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run validate:content && npm test",
    "test:publishing": "node scripts/validate/publishing-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-slug": "^6.0.0",
    "yaml": "^2.8.1",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "rollup": "4.68.4"
  }
}
